{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ChessEngine Debug",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/ChessEngine/bin/Debug/net10.0/ChessEngine.dll",
            "cwd": "${workspaceFolder}/ChessEngine",
            "launchSettingsFilePath": "${workspaceFolder}/Properties/launchSettings.json",
            "launchSettingsProfile": "ChessEngineDebug",
            "preLaunchTask": "dotnet: build"
        },
        {
            // Use Ctrl F5 in VS Code to run without debugger
            "name": "Benchmark (Release)",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/Benchmark/bin/Release/net10.0/Benchmark.dll",
            "cwd": "${workspaceFolder}/Benchmark",
            "preLaunchTask": "build Benchmark (Release)"
        }
    ]
}