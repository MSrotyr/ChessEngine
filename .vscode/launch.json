    "version": "0.2.0",
    "configurations": [
        {
            "name": "C#: ChessEngine Debug",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/ChessEngine/bin/Debug/net10.0/ChessEngine.dll",
            "cwd": "${workspaceFolder}/ChessEngine",
            "launchSettingsFilePath": "${workspaceFolder}/Properties/launchSettings.json",
            "launchSettingsProfile": "ChessEngineDebug",
            "preLaunchTask": "dotnet: build ${workspaceFolder}/ChessEngine/ChessEngine.csproj"
        },
        {
            "name": "C#: Benchmark",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/Benchmark/bin/Debug/net10.0/Benchmark.dll",
            "cwd": "${workspaceFolder}/Benchmark",
            "launchSettingsFilePath": "${workspaceFolder}/Properties/launchSettings.json",
            "launchSettingsProfile": "Benchmark",
        }
    ]
}